{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    /* 严格性 —— 见 docs/CONVENTIONS.md §4.1，禁止放宽 */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "jsx": "react-jsx",

    "baseUrl": ".",
    "paths": {
      "@tjre/schema": ["./packages/schema/src/index.ts"],
      "@tjre/core": ["./packages/core/src/index.ts"],
      "@tjre/core/node": ["./packages/core/src/node.ts"],
      "@tjre/scene": ["./packages/scene/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "scripts/**/*.ts",
    "*.config.ts",
    "three.alias.ts"
  ],
  "exclude": ["node_modules", "three.js", "**/dist"]
}
